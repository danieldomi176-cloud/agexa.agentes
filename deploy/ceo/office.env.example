# Non-secret deployment template; disabled until real host/CEO configuration is supplied.
AGEXA_CEO_BRIDGE_ENABLED=0
AGEXA_OFFICE_PUBLIC_ORIGIN=
AGEXA_CEO_READ_IDS=
AGEXA_CEO_CONTROL_IDS=
AGEXA_CEO_TRUSTED_PROXY_IP=127.0.0.1
AGEXA_CEO_BRIDGE_SECRET_FILE=/run/secrets/agexa_ceo_bridge_secret
# AGEXA_CEO_BRIDGE_SECRET must be absent when using the private file source.
# Preserve existing Gemini/Base44/WhatsApp settings in the actual host environment.
